{
  "name": "better-zujuan",
  "description": "改善组卷网试卷预览、页面净化与导出体验的开源浏览器扩展",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:build:firefox": "node scripts/verify-build.mjs .output/firefox-mv2",
    "check": "node scripts/lint-template-backticks.mjs && tsc --noEmit && vitest run && wxt build && node scripts/verify-build.mjs",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "wxt prepare"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "docx": "^9.12.0"
  }
}
